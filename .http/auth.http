@baseUrl = http://localhost:8080

@email = test1@example.com
@password = password
@name = Test User

@adminEmail = admin@example.com
@adminPassword = password

@userId = 1

### ========================================
### ユーザー
### ========================================


### 0. ユーザー登録
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}",
    "name": "{{name}}"
}


### 1. ユーザーログイン
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "{{email}}",
    "password": "{{password}}"
}


### 2. 自分のユーザー情報取得
GET {{baseUrl}}/api/user/me
Authorization: Bearer {{login.response.body.token}}


### 3. パスワード変更
# ログイン済みユーザーが自分のパスワードを変更する
POST {{baseUrl}}/api/auth/change-password
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
    "currentPassword": "{{password}}",
    "newPassword": "newPassword123"
}


### ========================================
### ADMIN
### ========================================


### 1. ADMINログイン
# @name adminLogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}


### 2. ADMIN - ユーザー一覧取得
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{adminLogin.response.body.token}}


### 3. ADMIN - ユーザー詳細取得
GET {{baseUrl}}/api/admin/users/{{userId}}
Authorization: Bearer {{adminLogin.response.body.token}}


### 4. ADMIN - ユーザーをADMINに変更
PUT {{baseUrl}}/api/admin/users/{{userId}}/role
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.token}}

{
    "role": "ADMIN"
}


### 5. ADMIN - ユーザーをUSERに変更
PUT {{baseUrl}}/api/admin/users/{{userId}}/role
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.token}}

{
    "role": "USER"
}


### 6. ADMIN - ユーザー削除
DELETE {{baseUrl}}/api/admin/users/{{userId}}
Authorization: Bearer {{adminLogin.response.body.token}}


### ========================================
### 権限チェック
### ========================================


### 1. USER - ADMIN APIにアクセス
# USERなので403 Forbiddenになる
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{login.response.body.token}}


### 2. JWTなし - ADMIN APIにアクセス
# JWTがないため401 Unauthorizedになる
GET {{baseUrl}}/api/admin/users
